   "source": [
    "count = 0\n",
    "total = 7\n",
    "\n",
    "probability = count / total\n",
    "\n",
    "print(\"Without smoothing:\", probability)\n",
    "\n",
    "k = 3\n",
    "\n",
    "probability_smoothing = (count + 1) / (total + k)\n",
    "\n",
    "print(\"With Laplace smoothing:\", probability_smoothing)"
